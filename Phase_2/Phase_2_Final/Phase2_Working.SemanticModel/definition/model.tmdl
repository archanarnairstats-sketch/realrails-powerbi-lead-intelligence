annotation PBI_ProTooling = ["DevMode"]

ref table DimLeadSource
ref table DimDate
ref table FactLead
ref table FactLeadActivity
ref table FactFollowUp
ref table FactAdmission
ref table FactEnrollment
ref table FactStatusHistory
ref table DimCounsellor
ref table DimProgram
ref table _Measures

